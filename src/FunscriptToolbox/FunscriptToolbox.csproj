<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0-windows'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Xabe.FFmpeg" Version="5.2.6" />
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="5.2.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioSynchronization\AudioSynchronization.csproj" />
    <ProjectReference Include="..\FunscriptToolbox.Core\FunscriptToolbox.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\FunscriptToolbox.UI\FunscriptToolbox.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="InstallationFiles\--FSTB-PrepareScriptForRelease.bat" />
    <EmbeddedResource Include="InstallationFiles\--FSTB-GenericCmd.bat" />
    <EmbeddedResource Include="InstallationFiles\--FSTB-CreateSubtitles.bat" />
    <EmbeddedResource Include="InstallationFiles\--FSTB-PrepareScriptForRelease.sh" />
    <EmbeddedResource Include="InstallationFiles\--FSTB-GenericCmd.sh" />
    <EmbeddedResource Include="InstallationFiles\--FSTB-CreateSubtitles.sh" />
    <EmbeddedResource Include="InstallationFiles\--FSTB-VerifyDownloadedScripts.sh" />
  </ItemGroup>

  <ItemGroup>
    <None Update="--FSTB-Installation.bat">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
